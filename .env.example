# ===== PostgreSQL =====
POSTGRES_DB=pickup
POSTGRES_USER=pickup
POSTGRES_PASSWORD=pickup
POSTGRES_PORT=5432

# ===== Backend =====
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ===== JWT =====
# Use a base64-encoded 256-bit secret in production
JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ===== Google (Phase 4C) =====
# Frontend: flutter run --dart-define=GOOGLE_PLACES_API_KEY=your-key
# Backend resolve proxy (required for Flutter web autocomplete selection):
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=

# ===== Google Maps SDK (event map screen) =====
# Separate from GOOGLE_PLACES_API_KEY/GOOGLE_ROUTES_API_KEY above — this key
# needs "Maps SDK for Android" / "Maps SDK for iOS" (and "Maps JavaScript API"
# for web) enabled, with billing, on the same Google Cloud project.
# This value is NOT read from this .env file by any Flutter build — only
# docker-compose reads .env, and only for the backend container.
#   Web:            flutter run -d chrome --dart-define=GOOGLE_MAPS_API_KEY=your-key
#                   (injected into the Maps JS SDK at startup — see
#                   lib/core/maps/maps_web_bootstrap_web.dart)
#   Android / iOS:  export GOOGLE_MAPS_API_KEY=your-key   before `flutter run`/`flutter build`
#                   (or `set -a && source .env && set +a` to load it from here into the shell)
GOOGLE_MAPS_API_KEY=
