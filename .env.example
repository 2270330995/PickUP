# ===== PostgreSQL =====
POSTGRES_DB=pickup
POSTGRES_USER=pickup
POSTGRES_PASSWORD=pickup
POSTGRES_PORT=5432

# ===== Backend =====
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ===== JWT =====
# Use a base64-encoded 256-bit secret in production
JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ===== Google (Phase 4C) =====
# Frontend: flutter run --dart-define=GOOGLE_PLACES_API_KEY=your-key
# Backend resolve proxy (required for Flutter web autocomplete selection):
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
